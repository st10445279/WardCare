<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header bar matching picture -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2150A2"
        android:gravity="center"
        android:text="@string/patient_detail"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPatientHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="J. Nkosi — Bed 4"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Card 1: Next appointment -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#EBF3FF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#2150A2"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tvNextAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Next appointment: 14:00"
                    android:textColor="#1F2937"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Med schedule -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#EBF3FF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#2150A2"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tvMedSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Med schedule: Amoxicillin 8h"
                    android:textColor="#1F2937"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Patient Profile & Medical Information Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal &amp; Medical Information"
                        android:textColor="#2150A2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvPatientId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient ID: P-101"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvAgeGenderBlood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Age: 42 yrs | Gender: Male | Blood Type: A+"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMedicalHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History: Hypertension, Asthma"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvAllergies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allergies: Penicillin"
                        android:textColor="#DC2626"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Buttons matching picture -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkDoseGiven"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Mark Dose Given"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2150A2"
                app:cornerRadius="8dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewFullHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="View Full History"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#2150A2"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
