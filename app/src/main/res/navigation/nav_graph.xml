<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.wardcare.app.ui.auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeDashboardFragment"
            app:destination="@id/homeDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.wardcare.app.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeDashboardFragment"
            app:destination="@id/homeDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.wardcare.app.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeDashboardFragment"
        android:name="com.wardcare.app.ui.dashboard.HomeDashboardFragment"
        android:label="Home Dashboard"
        tools:layout="@layout/fragment_home_dashboard" />

    <fragment
        android:id="@+id/patientListFragment"
        android:name="com.wardcare.app.ui.patients.PatientListFragment"
        android:label="Patient List"
        tools:layout="@layout/fragment_patient_list" />

    <fragment
        android:id="@+id/patientDetailFragment"
        android:name="com.wardcare.app.ui.patients.PatientDetailFragment"
        android:label="Patient Detail"
        tools:layout="@layout/fragment_patient_detail">
        <argument
            android:name="patientId"
            app:argType="string"
            android:defaultValue="patient-1" />
    </fragment>

    <fragment
        android:id="@+id/patientHistoryFragment"
        android:name="com.wardcare.app.ui.patients.PatientHistoryFragment"
        android:label="Patient Medical Records"
        tools:layout="@layout/fragment_patient_history">
        <argument
            android:name="patientId"
            app:argType="string"
            android:defaultValue="patient-1" />
    </fragment>

    <fragment
        android:id="@+id/logMedicationFragment"
        android:name="com.wardcare.app.ui.dashboard.LogMedicationFragment"
        android:label="Log Medication"
        tools:layout="@layout/fragment_log_medication" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.wardcare.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.wardcare.app.ui.settings.UserProfileFragment"
        android:label="User Profile"
        tools:layout="@layout/fragment_user_profile" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.wardcare.app.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

</navigation>
